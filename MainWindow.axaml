<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="CapAvalonia.MainWindow"
        Title="Cap"
        Width="330"
        Height="395"
        MinWidth="330"
        MinHeight="395"
        MaxWidth="330"
        MaxHeight="395"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        RequestedThemeVariant="Dark">

  <Window.Styles>
    <Style Selector="Button.toolbar">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#969696" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.toolbar:pointerover">
      <Setter Property="Background" Value="#292929" />
      <Setter Property="Foreground" Value="#F1F1F1" />
    </Style>
    <Style Selector="Button.capture">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#363636" />
      <Setter Property="BorderBrush" Value="#3B3B3B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#F0F0F0" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.capture:pointerover">
      <Setter Property="Background" Value="#3B3B3B" />
      <Setter Property="BorderBrush" Value="#4A4A4A" />
    </Style>
    <Style Selector="Button.mode-icon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#A9A9A9" />
      <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style Selector="Button.mode-icon:pointerover">
      <Setter Property="Background" Value="#303030" />
      <Setter Property="Foreground" Value="#F3F3F3" />
    </Style>
    <Style Selector="Button.mode-icon.selected">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Background" Value="#282828" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.audio-status">
      <Setter Property="Width" Value="40.5" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#323232" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#A8A8A8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <StreamGeometry x:Key="CameraInputIcon">M2.5 6.66666C2.5 5.28594 3.61929 4.16666 5 4.16666H10C11.3807 4.16666 12.5 5.28594 12.5 6.66666V13.3333C12.5 14.714 11.3807 15.8333 10 15.8333H5C3.61929 15.8333 2.5 14.714 2.5 13.3333V6.66666Z M12.9607 8.103L16.294 6.43633C16.8481 6.15929 17.5 6.5622 17.5 7.18169V12.8183C17.5 13.4378 16.8481 13.8407 16.294 13.5637L12.9607 11.897C12.6783 11.7558 12.5 11.4673 12.5 11.1516V8.84835C12.5 8.53271 12.6783 8.24416 12.9607 8.103Z</StreamGeometry>
    <StreamGeometry x:Key="MicrophoneInputIcon">M10 15.8333V17.5M10 15.8333C6.93483 15.8333 5.12236 13.9543 4.17862 12.5M10 15.8333C13.0652 15.8333 14.8777 13.9543 15.8214 12.5M13.3333 5.83333V9.16667C13.3333 11.0076 11.841 12.5 10 12.5C8.15906 12.5 6.66668 11.0076 6.66668 9.16667V5.83333C6.66668 3.99238 8.15906 2.5 10 2.5C11.841 2.5 13.3333 3.99238 13.3333 5.83333Z</StreamGeometry>
    <Pen x:Key="CapLogoOutline" Brush="#E7EAF0" Thickness="0.5" />
    <DrawingImage x:Key="CapLogoFullDark">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Geometry="M0,0 H103 V40 H0 Z" Brush="#00FFFFFF" />
          <GeometryDrawing Geometry="M32 0.25H8C3.71979 0.25 0.25 3.71979 0.25 8V32C0.25 36.2802 3.71979 39.75 8 39.75H32C36.2802 39.75 39.75 36.2802 39.75 32V8C39.75 3.71979 36.2802 0.25 32 0.25Z" Brush="#FFFFFF" />
          <GeometryDrawing Geometry="M32 0.25H8C3.71979 0.25 0.25 3.71979 0.25 8V32C0.25 36.2802 3.71979 39.75 8 39.75H32C36.2802 39.75 39.75 36.2802 39.75 32V8C39.75 3.71979 36.2802 0.25 32 0.25Z" Brush="{x:Null}" Pen="{StaticResource CapLogoOutline}" />
          <GeometryDrawing Geometry="M20 36C28.8365 36 36 28.8365 36 20C36 11.1635 28.8365 4 20 4C11.1635 4 4 11.1635 4 20C4 28.8365 11.1635 36 20 36Z" Brush="#12161F" />
          <GeometryDrawing Geometry="M20.0001 33C27.1797 33 33 27.1797 33 20.0001C33 12.8203 27.1797 7 20.0001 7C12.8203 7 7 12.8204 7 20.0001C7 27.1797 12.8204 33 20.0001 33Z" Brush="#C9CEDB" />
          <GeometryDrawing Geometry="M20.0001 30.0002C25.5229 30.0002 30.0002 25.5229 30.0002 20.0001C30.0002 14.4773 25.5229 10.0002 20.0001 10.0002C14.4773 10.0002 10.0002 14.4773 10.0002 20.0001C10.0002 25.5229 14.4773 30.0002 20.0001 30.0002Z" Brush="#FFFFFF" />
          <GeometryDrawing Geometry="M58.416 30.448C53.012 30.448 49.204 26.584 49.204 20.088C49.204 13.704 52.872 9.672 58.472 9.672C63.54 9.672 66.256 12.332 67.096 16.84L63.288 17.036C62.812 14.432 61.216 12.836 58.472 12.836C55.084 12.836 52.984 15.664 52.984 20.088C52.984 24.568 55.14 27.284 58.444 27.284C61.384 27.284 62.952 25.576 63.4 22.72L67.208 22.916C66.424 27.592 63.456 30.448 58.416 30.448ZM74.6451 30.336C71.5091 30.336 69.4371 28.852 69.4371 26.248C69.4371 23.672 71.0331 22.3 74.3091 21.656L79.2651 20.676C79.2651 18.576 78.2851 17.484 76.4091 17.484C74.6451 17.484 73.6931 18.296 73.3571 19.808L69.6891 19.64C70.2771 16.504 72.6851 14.712 76.4091 14.712C80.6651 14.712 82.8491 16.952 82.8491 20.928V26.36C82.8491 27.172 83.1291 27.396 83.6891 27.396H84.1651V30C83.9411 30.056 83.3531 30.112 82.8771 30.112C81.2531 30.112 80.0491 29.524 79.7411 27.676C79.0131 29.272 77.1091 30.336 74.6451 30.336ZM75.3731 27.732C77.7531 27.732 79.2651 26.22 79.2651 23.952V23.112L75.4011 23.896C73.8051 24.204 73.1611 24.876 73.1611 25.912C73.1611 27.088 73.9451 27.732 75.3731 27.732ZM86.8741 34.2V15.048H90.3181L90.3741 17.26C91.2421 15.608 92.8941 14.712 94.8541 14.712C99.1101 14.712 101.21 18.212 101.21 22.524C101.21 26.836 99.0821 30.336 94.8261 30.336C92.9221 30.336 91.2701 29.412 90.4581 27.956V34.2H86.8741ZM93.9861 27.424C96.1701 27.424 97.4861 25.604 97.4861 22.524C97.4861 19.444 96.1701 17.624 93.9861 17.624C91.8021 17.624 90.4581 19.276 90.4581 22.524C90.4581 25.772 91.7741 27.424 93.9861 27.424Z" Brush="#FFFFFF" />
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
  </Window.Resources>

  <Border Background="#131313"
          BorderBrush="#303030"
          BorderThickness="1"
          CornerRadius="15"
          ClipToBounds="True">
    <Grid RowDefinitions="36,*">
      <!-- Cap's compact in-window toolbar -->
      <Border Grid.Row="0" Background="#1B1B1B" />
      <Grid Grid.Row="0" Margin="8,2,7,6" ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button x:Name="RecordButton" Classes="toolbar" Click="OnCaptureButtonClick" ToolTip.Tip="Start recording">
            <Ellipse x:Name="RecordGlyph" Width="14" Height="14" Fill="#F2F2F2" />
          </Button>
          <Button Classes="toolbar" Click="OnOpenHelp" ToolTip.Tip="Open Cap help">
            <Viewbox Width="16" Height="16"><Path Data="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10Zm0-6v.01M9.09 9a3 3 0 0 1 5.83 1c0 2-3 2-3 4" Fill="Transparent" Stroke="#969696" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" /></Viewbox>
          </Button>
        </StackPanel>
        <Border Grid.Column="1" Background="Transparent" PointerPressed="OnDragRegionPointerPressed" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="toolbar" Click="OnOpenSettings" ToolTip.Tip="Settings">
            <Viewbox Width="16" Height="16"><Path Data="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm0-6 1.2 2.1 2.4.5 2-.9 2 2-1 2 .6 2.3L22 11v2l-2.2 1-.6 2.3 1 2-2 2-2-1-2.3.6L13 22h-2l-1-2.1-2.3-.6-2 1-2-2 1-2-.6-2.3L2 13v-2l2.1-1 .6-2.3-1-2 2-2 2 1L10 4l1-2Z" Fill="Transparent" Stroke="#969696" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" /></Viewbox>
          </Button>
          <Button Classes="toolbar" Click="OnOpenScreenshots" ToolTip.Tip="Screenshots">
            <Viewbox Width="16" Height="16"><Path Data="M4 4h16v16H4zM4 15l4-4 4 4 3-3 5 5m-6-9h.01" Fill="Transparent" Stroke="#969696" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" /></Viewbox>
          </Button>
          <Button Classes="toolbar" Click="OnOpenRecordings" ToolTip.Tip="Recordings">
            <Viewbox Width="16" Height="16"><Path Data="M5 3h14v18H5zM5 7h14M10 11v6l5-3Z" Fill="Transparent" Stroke="#969696" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" /></Viewbox>
          </Button>
          <Button Classes="toolbar" Click="OnOpenTeleprompter" ToolTip.Tip="Teleprompter">
            <Viewbox Width="16" Height="16"><Path Data="M4 7V5a2 2 0 0 1 2-2h2m10 0h2a2 2 0 0 1 2 2v2m0 10v2a2 2 0 0 1-2 2h-2M8 21H6a2 2 0 0 1-2-2v-2m4-8h8m-8 4h6" Fill="Transparent" Stroke="#969696" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" /></Viewbox>
          </Button>
          <Button Classes="toolbar" Click="OnOpenNotifications" ToolTip.Tip="Activity">
            <Grid Width="18" Height="19">
              <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" Fill="Transparent" Stroke="#969696" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" /></Viewbox>
              <Ellipse x:Name="ActivityDot" Width="6" Height="6" Fill="#F04444" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="False" />
            </Grid>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1"
            Margin="12,15,12,14"
            RowDefinitions="36,20.5,57,8,57,7.5,42,8,42,8,42">
        <!-- Brand, workspace, and three recording modes -->
        <Grid Grid.Row="0" ColumnDefinitions="*,114">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
            <StackPanel.RenderTransform>
              <TranslateTransform Y="3" />
            </StackPanel.RenderTransform>
            <Image Source="{StaticResource CapLogoFullDark}" Width="92" Height="35.73" Stretch="Fill" VerticalAlignment="Center" />
            <Border Margin="12,0,0,0" Padding="4,2" Background="#292929" BorderBrush="#3B3B3B" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
              <TextBlock Text="Personal" FontSize="9.6" FontWeight="Regular" Foreground="#E7E7E7" />
            </Border>
          </StackPanel>

          <Border Grid.Column="1"
                  Width="114"
                  Height="42"
                  Background="#252525"
                  BorderBrush="#303030"
                  BorderThickness="1"
                  CornerRadius="22"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  >
            <Border.RenderTransform>
              <TranslateTransform Y="3" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Button x:Name="InstantModeButton" Classes="mode-icon" Tag="Instant" Click="OnModeClick" ToolTip.Tip="Instant mode">
                <Border x:Name="InstantModeFrame" Width="28" Height="28" CornerRadius="17" BorderThickness="0" BorderBrush="Transparent" Background="#363636">
                  <Image Source="avares://CapAvalonia/assets/Cap/instant.png" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Button>
              <Button x:Name="StudioModeButton" Classes="mode-icon selected" Tag="Studio" Click="OnModeClick" ToolTip.Tip="Studio mode">
                <Border x:Name="StudioModeFrame" Width="34" Height="34" CornerRadius="18" BorderThickness="2.5" BorderBrush="#3B82F6" Background="#292929">
                  <Image Source="avares://CapAvalonia/assets/Cap/film-cut.png" Width="14.4" Height="14.4" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Button>
              <Button x:Name="ScreenshotModeButton" Classes="mode-icon" Tag="Screenshot" Click="OnModeClick" ToolTip.Tip="Screenshot mode">
                <Border x:Name="ScreenshotModeFrame" Width="28" Height="28" CornerRadius="17" BorderThickness="0" BorderBrush="Transparent" Background="#363636">
                  <Image Source="avares://CapAvalonia/assets/Cap/screenshot.png" Width="14.4" Height="14.4" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Button>
            </StackPanel>
          </Border>
          <Button Grid.Column="1" Width="18" Height="18" Padding="4" Margin="-5,-7,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#303030" BorderThickness="0" CornerRadius="9" ToolTip.Tip="Recording mode info" AutomationProperties.Name="Recording mode info" ZIndex="2">
            <Image Source="avares://CapAvalonia/assets/Cap/info.png" Width="10" Height="10" Stretch="Uniform" />
          </Button>
        </Grid>

        <!-- Capture targets -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
      <Button Classes="capture" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnDisplayTargetClick" ToolTip.Tip="Choose a display">
            <Grid ColumnDefinitions="*,28">
              <StackPanel Grid.Column="0" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.RenderTransform><TranslateTransform X="10" Y="-1" /></StackPanel.RenderTransform>
                <Viewbox Width="19.5" Height="20" RenderTransformOrigin="0.5,0.5">
                  <Viewbox.RenderTransform><TranslateTransform X="-1" Y="-1" /></Viewbox.RenderTransform>
                  <Path Data="M3 4h18v13H3zM8 21h8m-4-4v4" Fill="Transparent" Stroke="#898989" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                </Viewbox>
                <TextBlock Text="Display" FontSize="12" FontWeight="Regular" Foreground="#F0F0F0">
                  <TextBlock.RenderTransform><TranslateTransform Y="1" /></TextBlock.RenderTransform>
                </TextBlock>
              </StackPanel>
              <Border Grid.Column="1" Background="#252525" BorderBrush="#3A3A3A" BorderThickness="1,0,0,0" CornerRadius="0,9,9,0">
                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="m6 9 6 6 6-6" Fill="Transparent" Stroke="#929292" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" /></Viewbox>
              </Border>
            </Grid>
          </Button>
          <Button Classes="capture" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnWindowTargetClick" ToolTip.Tip="Select a window's screen area">
            <Grid ColumnDefinitions="*,28">
              <StackPanel Grid.Column="0" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.RenderTransform><TranslateTransform X="10" Y="-1" /></StackPanel.RenderTransform>
                <Viewbox Width="21.5" Height="16.5" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                  <Viewbox.RenderTransform><TranslateTransform X="-1.5" /></Viewbox.RenderTransform>
                  <Path Data="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 18.5Zm0 4h16M7 6.5h.01M10 6.5h.01M13 6.5h.01" Fill="Transparent" Stroke="#898989" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                </Viewbox>
                <TextBlock Text="Window" FontSize="12" FontWeight="Regular" Foreground="#F0F0F0">
                  <TextBlock.RenderTransform><TranslateTransform Y="3" /></TextBlock.RenderTransform>
                </TextBlock>
              </StackPanel>
              <Border Grid.Column="1" Background="#252525" BorderBrush="#3A3A3A" BorderThickness="1,0,0,0" CornerRadius="0,9,9,0">
                <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="m6 9 6 6 6-6" Fill="Transparent" Stroke="#929292" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" /></Viewbox>
              </Border>
            </Grid>
          </Button>
        </Grid>

        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="8">
          <Button Classes="capture" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnAreaTargetClick" ToolTip.Tip="Select an area to capture">
            <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel.RenderTransform><TranslateTransform Y="-1" /></StackPanel.RenderTransform>
              <Viewbox Width="18.5" Height="13" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                <Viewbox.RenderTransform><TranslateTransform X="-0.75" Y="-0.25" /></Viewbox.RenderTransform>
                <Path Data="M8 3H5a2 2 0 0 0-2 2v3m13-5h3a2 2 0 0 1 2 2v3M3 16v3a2 2 0 0 0 2 2h3m8 0h3a2 2 0 0 0 2-2v-3" Fill="Transparent" Stroke="#898989" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
              </Viewbox>
              <TextBlock Text="Area" FontSize="12" FontWeight="Regular" Foreground="#F0F0F0">
                <TextBlock.RenderTransform><TranslateTransform Y="4.5" /></TextBlock.RenderTransform>
              </TextBlock>
            </StackPanel>
          </Button>
          <Button x:Name="CameraOnlyButton" Classes="capture" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="OnCameraOnlyClick" ToolTip.Tip="Record from a camera only">
            <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel.RenderTransform><TranslateTransform Y="-1" /></StackPanel.RenderTransform>
              <Viewbox Width="20" Height="16.5" Stretch="Fill" RenderTransformOrigin="0.5,0.5">
                <Viewbox.RenderTransform><TranslateTransform X="-1" Y="-1.75" /></Viewbox.RenderTransform>
                <Path Data="M3 8a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Zm14 2 4-3v10l-4-3Z" Fill="Transparent" Stroke="#898989" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
              </Viewbox>
              <TextBlock Text="Camera Only" FontSize="12" FontWeight="Regular" Foreground="#F0F0F0">
                <TextBlock.RenderTransform><TranslateTransform Y="3.25" /></TextBlock.RenderTransform>
              </TextBlock>
            </StackPanel>
          </Button>
        </Grid>

        <!-- Optional capture inputs -->
        <Border Grid.Row="6" Background="#262626" BorderBrush="#3B3B3B" BorderThickness="1" CornerRadius="8">
          <Grid ColumnDefinitions="16,*,40.5" ColumnSpacing="10" Margin="12,0,5.5,0">
            <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"><Path Data="{StaticResource CameraInputIcon}" Fill="Transparent" Stroke="#8A8A8A" StrokeThickness="1.34" StrokeJoin="Round" /></Viewbox>
            <Button x:Name="CameraDeviceButton" Grid.Column="1" Content="No Camera" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#F0F0F0" Padding="0" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" Click="OnChooseCamera" />
            <Button x:Name="CameraAudioButton" Grid.Column="2" Classes="audio-status" Content="Off" VerticalAlignment="Center" Click="OnCameraAudioClick" />
          </Grid>
        </Border>
        <Border Grid.Row="8" Background="#262626" BorderBrush="#3B3B3B" BorderThickness="1" CornerRadius="8">
          <Grid ColumnDefinitions="16,*,40.5" ColumnSpacing="10" Margin="12,0,5.5,0">
            <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"><Path Data="{StaticResource MicrophoneInputIcon}" Fill="Transparent" Stroke="#8A8A8A" StrokeThickness="1.34" StrokeLineCap="Round" StrokeJoin="Round" /></Viewbox>
            <Button x:Name="MicrophoneDeviceButton" Grid.Column="1" Content="No Microphone" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#F0F0F0" Padding="0" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" Click="OnChooseMicrophone" />
            <Button x:Name="MicrophoneAudioButton" Grid.Column="2" Classes="audio-status" Content="Off" VerticalAlignment="Center" Click="OnMicrophoneClick" />
          </Grid>
        </Border>
        <Border Grid.Row="10" Background="#262626" BorderBrush="#3B3B3B" BorderThickness="1" CornerRadius="8">
          <Grid ColumnDefinitions="16,*,40.5" ColumnSpacing="10" Margin="12,0,5.5,0">
            <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"><Path Data="M3 5h18v12H3zM8 21h8m-4-4v4" Fill="Transparent" Stroke="#8A8A8A" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" /></Viewbox>
            <Button x:Name="SystemAudioDeviceButton" Grid.Column="1" Content="No System Audio" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#F0F0F0" Padding="0" FontSize="14" FontWeight="Regular" VerticalAlignment="Center" Click="OnChooseSystemAudio" />
            <Button x:Name="SystemAudioStatusButton" Grid.Column="2" Classes="audio-status" Content="Off" VerticalAlignment="Center" Click="OnSystemAudioClick" />
          </Grid>
        </Border>
      </Grid>
      <Border x:Name="CaptureStatusToast"
              Grid.Row="1"
              IsVisible="False"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="14,0,14,18"
              Padding="10,7"
              Background="#2A2A2A"
              BorderBrush="#414141"
              BorderThickness="1"
              CornerRadius="9">
        <TextBlock x:Name="CaptureStatus"
                   FontSize="11"
                   Foreground="#F0F0F0"
                   TextWrapping="Wrap"
                   MaxWidth="285" />
      </Border>
    </Grid>
  </Border>
</Window>

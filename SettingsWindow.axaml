<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CapAvalonia.SettingsWindow"
        Title=""
        Width="782"
        Height="775"
        MinWidth="720"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#111111"
        RequestedThemeVariant="Dark">

  <Window.Resources>
    <StreamGeometry x:Key="GearIcon">M12 2 14 4.2 16.8 4.7 19.4 3.6 21.4 5.6 20.3 8.2 20.8 11 23 12 22 14.1 19.8 15.1 19.3 17.9 20.4 20.5 18.4 22.5 15.8 21.4 13 21.9 12 24 10 23 9 20.8 6.2 20.3 3.6 21.4 1.6 19.4 2.7 16.8 2.2 14 0 13 1 11 3.2 10 3.7 7.2 2.6 4.6 4.6 2.6 7.2 3.7 10 3.2Z M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z</StreamGeometry>
    <StreamGeometry x:Key="SlidersIcon">M4 6h16M4 12h16M4 18h16M8 3v6m8 0v6m-5 0v6</StreamGeometry>
    <StreamGeometry x:Key="ShortcutIcon">M8 3H6a3 3 0 0 0-3 3v2m13-5h2a3 3 0 0 1 3 3v2M3 16v2a3 3 0 0 0 3 3h2m8 0h2a3 3 0 0 0 3-3v-2M8 12h8m-4-4v8</StreamGeometry>
    <StreamGeometry x:Key="TerminalIcon">M4 6l6 6-6 6m8 0h8</StreamGeometry>
    <StreamGeometry x:Key="RecordingsIcon">M4 4h16v16H4z M10 8v8l6-4Z</StreamGeometry>
    <StreamGeometry x:Key="ImageIcon">M4 4h16v16H4z M4 15l4-4 4 4 3-3 5 5 M15 8h.01</StreamGeometry>
    <StreamGeometry x:Key="BoltIcon">M13 2 4 13h6l-1 9 9-12h-6Z</StreamGeometry>
    <StreamGeometry x:Key="TranscriptIcon">M4 5h16v14H4z M7 9h10m-10 3h10m-10 3h6</StreamGeometry>
    <StreamGeometry x:Key="PlugIcon">M9 3v6m6-6v6M6 9h12v3a6 6 0 0 1-12 0Zm6 9v3</StreamGeometry>
    <StreamGeometry x:Key="GiftIcon">M3 10h18v11H3z M2 6h20v4H2z M12 6v15m0-15H8a2 2 0 1 1 2-2c1 1 2 2 2 2Zm0 0h4a2 2 0 1 0-2-2c-1 1-2 2-2 2Z</StreamGeometry>
    <StreamGeometry x:Key="FeedbackIcon">M4 4h16v13H9l-5 4z M8 10h8m-4-4v8</StreamGeometry>
    <StreamGeometry x:Key="BellIcon">M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4</StreamGeometry>
    <StreamGeometry x:Key="AccountIcon">M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-8 9a8 8 0 0 1 16 0</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#E5E5E5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#292929" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="#303030" />
      <Setter Property="Foreground" Value="#F5F5F5" />
    </Style>
    <Style Selector="Button.theme-card">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Foreground" Value="#A8A8A8" />
      <Setter Property="CornerRadius" Value="11" />
    </Style>
    <Style Selector="Button.theme-card:pointerover">
      <Setter Property="Foreground" Value="#F0F0F0" />
    </Style>
    <Style Selector="Button.theme-card.selected">
      <Setter Property="BorderBrush" Value="#1684FF" />
      <Setter Property="Foreground" Value="#F2F2F2" />
    </Style>
    <Style Selector="Button.action">
      <Setter Property="Height" Value="38" />
      <Setter Property="Background" Value="#303030" />
      <Setter Property="BorderBrush" Value="#414141" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#F0F0F0" />
      <Setter Property="CornerRadius" Value="22" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="228,*">
    <!-- Settings navigation -->
    <Border Grid.Column="0" Background="#1D1D1D" BorderBrush="#2C2C2C" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Margin="14,14,12,18" ColumnDefinitions="34,*" Height="42">
          <Border Width="32" Height="32" CornerRadius="18" Background="#353535" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource AccountIcon}" Width="19" Height="19" Foreground="#D0D0D0" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0" Spacing="1">
            <TextBlock Text="Local workspace" FontSize="13" Foreground="#F2F2F2" />
            <TextBlock Text="This device" FontSize="12" Foreground="#999999" />
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="10,0,10,10" Spacing="2">
            <Button x:Name="NavGeneral" Classes="nav selected" Tag="General" Click="OnNavigationClick">
              <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                <PathIcon Data="{StaticResource GearIcon}" Width="15" Height="15" Foreground="#1684FF" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="General" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button x:Name="NavQuality" Classes="nav" Tag="Recording quality" Click="OnNavigationClick">
              <Grid ColumnDefinitions="20,*" ColumnSpacing="10"><PathIcon Data="{StaticResource SlidersIcon}" Width="15" Height="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Recording quality" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Classes="nav" Tag="Shortcuts" Click="OnNavigationClick">
              <Grid ColumnDefinitions="20,*" ColumnSpacing="10"><PathIcon Data="{StaticResource ShortcutIcon}" Width="15" Height="15" Foreground="#A4A4A4" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Shortcuts" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Classes="nav" Tag="CLI" Click="OnNavigationClick">
              <Grid ColumnDefinitions="20,*" ColumnSpacing="10"><PathIcon Data="{StaticResource TerminalIcon}" Width="15" Height="15" Foreground="#A4A4A4" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="CLI" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Classes="nav" Tag="Recordings" Click="OnNavigationClick">
              <Grid ColumnDefinitions="20,*" ColumnSpacing="10"><PathIcon Data="{StaticResource RecordingsIcon}" Width="15" Height="15" Foreground="#A4A4A4" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Recordings" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Classes="nav" Tag="Screenshots" Click="OnNavigationClick">
              <Grid ColumnDefinitions="20,*" ColumnSpacing="10"><PathIcon Data="{StaticResource ImageIcon}" Width="15" Height="15" Foreground="#A4A4A4" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Screenshots" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Classes="nav" Tag="Automations" Click="OnNavigationClick">
              <Grid ColumnDefinitions="20,*" ColumnSpacing="10"><PathIcon Data="{StaticResource BoltIcon}" Width="15" Height="15" Foreground="#A4A4A4" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Automations" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Classes="nav" Tag="Transcription" Click="OnNavigationClick">
              <Grid ColumnDefinitions="20,*" ColumnSpacing="10"><PathIcon Data="{StaticResource TranscriptIcon}" Width="15" Height="15" Foreground="#A4A4A4" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Transcription" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Classes="nav" Tag="Integrations" Click="OnNavigationClick">
              <Grid ColumnDefinitions="20,*" ColumnSpacing="10"><PathIcon Data="{StaticResource PlugIcon}" Width="15" Height="15" Foreground="#A4A4A4" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Integrations" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Classes="nav" Tag="Plan &amp; license" Click="OnNavigationClick">
              <Grid ColumnDefinitions="20,*" ColumnSpacing="10"><PathIcon Data="{StaticResource GiftIcon}" Width="15" Height="15" Foreground="#A4A4A4" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Plan &amp; license" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Classes="nav" Tag="Experimental" Click="OnNavigationClick">
              <Grid ColumnDefinitions="20,*" ColumnSpacing="10"><PathIcon Data="{StaticResource GearIcon}" Width="15" Height="15" Foreground="#A4A4A4" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Experimental" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Classes="nav" Tag="Feedback" Click="OnNavigationClick">
              <Grid ColumnDefinitions="20,*" ColumnSpacing="10"><PathIcon Data="{StaticResource FeedbackIcon}" Width="15" Height="15" Foreground="#A4A4A4" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Feedback" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button Classes="nav" Tag="Changelog" Click="OnNavigationClick">
              <Grid ColumnDefinitions="20,*" ColumnSpacing="10"><PathIcon Data="{StaticResource BellIcon}" Width="15" Height="15" Foreground="#A4A4A4" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="Changelog" VerticalAlignment="Center" /></Grid>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#303030" BorderThickness="0,1,0,0" Padding="10,8,10,10">
          <StackPanel Spacing="6">
            <TextBlock Text="Avalonia port" FontSize="11" Foreground="#999999" Margin="0,0,0,1" />
            <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" Foreground="#777777" FontSize="11" Content="View previous versions" IsEnabled="False" ToolTip.Tip="Online release history is not connected." />
            <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left" Foreground="#777777" FontSize="11" Content="Check for updates" IsEnabled="False" ToolTip.Tip="The updater is not connected in this build." />
            <Button Classes="action" Content="Local only" Margin="0,3,0,0" IsEnabled="False" ToolTip.Tip="No Cap account is signed in." />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- The General page mirrors Cap's Appearance, App, and Recording settings. -->
    <ScrollViewer Grid.Column="1" x:Name="GeneralContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20,18,20,24" Spacing="28">
        <StackPanel Spacing="4">
          <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold" Foreground="#F1F1F1" />
          <TextBlock Text="Choose the look used by this Cap Avalonia build." FontSize="12" Foreground="#A1A1A1" />
          <Border Margin="-4,8,-4,0" Padding="16" Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <Button Classes="theme-card" Grid.Column="0" IsEnabled="False" ToolTip.Tip="System theme switching is not available in this build.">
                <StackPanel Spacing="7">
                  <Border Height="88" CornerRadius="9" BorderBrush="#333333" BorderThickness="1" ClipToBounds="True" Background="#F2F2F2">
                    <Grid ColumnDefinitions="36,*">
                      <Border Grid.Column="0" Background="#303039" />
                      <StackPanel Grid.Column="1" Margin="7" Spacing="5" VerticalAlignment="Center">
                        <Border Height="17" Background="#FFFFFF" CornerRadius="4"><Grid ColumnDefinitions="*,13"><Border Margin="5,7,14,7" Background="#454545" CornerRadius="3"/><Ellipse Grid.Column="1" Width="9" Height="9" Fill="#FB365B" VerticalAlignment="Center"/></Grid></Border>
                        <Border Height="17" Background="#FFFFFF" CornerRadius="4"><Grid ColumnDefinitions="*,13"><Border Margin="5,7,26,7" Background="#454545" CornerRadius="3"/><Ellipse Grid.Column="1" Width="9" Height="9" Fill="#3A87FF" VerticalAlignment="Center"/></Grid></Border>
                        <Border Height="17" Background="#FFFFFF" CornerRadius="4"><Grid ColumnDefinitions="*,13"><Border Margin="5,7,18,7" Background="#454545" CornerRadius="3"/><Ellipse Grid.Column="1" Width="9" Height="9" Fill="#3A87FF" VerticalAlignment="Center"/></Grid></Border>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <TextBlock Text="System" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="theme-card" Grid.Column="1" IsEnabled="False" ToolTip.Tip="Light theme is not available in this build.">
                <StackPanel Spacing="7">
                  <Border Height="88" CornerRadius="9" BorderBrush="#333333" BorderThickness="1" ClipToBounds="True" Background="#F3F3F3">
                    <Grid ColumnDefinitions="36,*"><Border Background="#4282F5"/><StackPanel Grid.Column="1" Margin="7" Spacing="5" VerticalAlignment="Center"><Border Height="17" Background="#FFFFFF" CornerRadius="4"><Border Margin="8,7,34,7" Background="#3D3D3D" CornerRadius="3"/></Border><Border Height="17" Background="#FFFFFF" CornerRadius="4"><Border Margin="8,7,21,7" Background="#3D3D3D" CornerRadius="3"/></Border><Border Height="17" Background="#FFFFFF" CornerRadius="4"><Border Margin="8,7,39,7" Background="#3D3D3D" CornerRadius="3"/></Border></StackPanel></Grid>
                  </Border>
                  <TextBlock Text="Light" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="theme-card selected" Grid.Column="2" IsEnabled="False" ToolTip.Tip="Dark theme is active.">
                <StackPanel Spacing="7">
                  <Border Height="88" CornerRadius="9" BorderBrush="#333333" BorderThickness="1" ClipToBounds="True" Background="#25252C">
                    <Grid ColumnDefinitions="36,*"><Border Background="#28264B"/><StackPanel Grid.Column="1" Margin="7" Spacing="5" VerticalAlignment="Center"><Border Height="17" Background="#151515" CornerRadius="4"><Border Margin="8,7,30,7" Background="#E0E0E0" CornerRadius="3"/></Border><Border Height="17" Background="#151515" CornerRadius="4"><Border Margin="8,7,20,7" Background="#E0E0E0" CornerRadius="3"/></Border><Border Height="17" Background="#151515" CornerRadius="4"><Border Margin="8,7,37,7" Background="#E0E0E0" CornerRadius="3"/></Border></StackPanel></Grid>
                  </Border>
                  <TextBlock Text="Dark" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <TextBlock Text="This build currently uses the dark theme." FontSize="11" Foreground="#888888" Margin="2,5,0,0" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="App" FontSize="14" FontWeight="SemiBold" Foreground="#F1F1F1" />
          <TextBlock Text="Choose how Cap Avalonia shows up on your system." FontSize="12" Foreground="#A1A1A1" />
          <Border Margin="-4,8,-4,0" Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12">
            <StackPanel>
              <Grid MinHeight="63" ColumnDefinitions="*,Auto" Margin="12,8,12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="Always show dock icon" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Dock visibility is controlled by the operating system in this build." FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/></StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="True" OnContent="" OffContent="" Width="38" VerticalAlignment="Center" Margin="12,0,0,0" IsEnabled="False" ToolTip.Tip="Dock behavior is controlled by the operating system." />
              </Grid>
              <Border Height="1" Background="#2F2F2F" />
              <Grid MinHeight="77" ColumnDefinitions="*,Auto" Margin="12,8,12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="System notifications" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Native system notifications are not connected in this build." FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/></StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="False" OnContent="" OffContent="" Width="38" VerticalAlignment="Center" Margin="12,0,0,0" IsEnabled="False" ToolTip.Tip="Native system notifications are not connected." />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Recording" FontSize="14" FontWeight="SemiBold" Foreground="#F1F1F1" />
          <TextBlock Text="Behaviour while you record and after you stop." FontSize="12" Foreground="#A1A1A1" />
          <Border Margin="-4,8,-4,0" Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12">
            <StackPanel>
              <Grid MinHeight="62" ColumnDefinitions="*,Auto" Margin="12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="Countdown" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Wait before the recording starts." FontSize="12" Foreground="#A0A0A0"/></StackPanel>
                <ComboBox Grid.Column="1" SelectedIndex="1" Width="100" Height="29" VerticalAlignment="Center" Background="#282828" BorderBrush="#383838" Foreground="#EEEEEE" CornerRadius="9">
                  <ComboBoxItem Content="No countdown"/><ComboBoxItem Content="3 seconds"/><ComboBoxItem Content="5 seconds"/>
                </ComboBox>
              </Grid>
              <Border Height="1" Background="#2F2F2F" />
              <Grid MinHeight="62" ColumnDefinitions="*,Auto" Margin="12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="Confirm before recording without a microphone" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Ask before recording while the microphone is turned off." FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/></StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="True" OnContent="" OffContent="" Width="38" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
              <Border Height="1" Background="#2F2F2F" />
              <Grid MinHeight="62" ColumnDefinitions="*,Auto" Margin="12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="Studio Sound on new recordings" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Clean up microphone audio automatically. You can still turn it off for any recording in the editor." FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/></StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="True" OnContent="" OffContent="" Width="38" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
              <Border Height="1" Background="#2F2F2F" />
              <Grid MinHeight="62" ColumnDefinitions="*,Auto" Margin="12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="Main window when recording starts" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Choose what happens to the recorder window." FontSize="12" Foreground="#A0A0A0"/></StackPanel>
                <ComboBox Grid.Column="1" SelectedIndex="0" Width="74" Height="29" VerticalAlignment="Center" Background="#282828" BorderBrush="#383838" Foreground="#EEEEEE" CornerRadius="9"><ComboBoxItem Content="Close"/><ComboBoxItem Content="Minimize"/><ComboBoxItem Content="Keep open"/></ComboBox>
              </Grid>
              <Border Height="1" Background="#2F2F2F" />
              <Grid MinHeight="62" ColumnDefinitions="*,Auto" Margin="12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="After a Studio recording" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="What happens once you stop a Studio recording." FontSize="12" Foreground="#A0A0A0"/></StackPanel>
                <ComboBox Grid.Column="1" SelectedIndex="0" Width="158" Height="29" VerticalAlignment="Center" Background="#282828" BorderBrush="#383838" Foreground="#EEEEEE" CornerRadius="9"><ComboBoxItem Content="Open editor"/><ComboBoxItem Content="Open in video player"/></ComboBox>
              </Grid>
              <Border Height="1" Background="#2F2F2F" />
              <Grid MinHeight="62" ColumnDefinitions="*,Auto" Margin="12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="After deleting a recording" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Whether the recording window should reopen." FontSize="12" Foreground="#A0A0A0"/></StackPanel>
                <ComboBox Grid.Column="1" SelectedIndex="0" Width="148" Height="29" VerticalAlignment="Center" Background="#282828" BorderBrush="#383838" Foreground="#EEEEEE" CornerRadius="9"><ComboBoxItem Content="Do nothing"/><ComboBoxItem Content="Reopen window"/></ComboBox>
              </Grid>
              <Border Height="1" Background="#2F2F2F" />
              <Grid MinHeight="62" ColumnDefinitions="*,Auto" Margin="12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="Delete Instant recordings after upload" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="This build saves Instant recordings locally and has no upload service." FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/></StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="False" OnContent="" OffContent="" Width="38" VerticalAlignment="Center" Margin="12,0,0,0" IsEnabled="False" ToolTip.Tip="Upload and delete behavior is unavailable in this local-only build." />
              </Grid>
              <Border Height="1" Background="#2F2F2F" />
              <Grid MinHeight="68" ColumnDefinitions="*,Auto" Margin="12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="Crash-recoverable recording" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Record in fragments that can be recovered after a crash or power loss. Uses slightly more space during capture." FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/></StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="True" OnContent="" OffContent="" Width="38" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
              <Border Height="1" Background="#2F2F2F" />
              <Grid MinHeight="68" ColumnDefinitions="*,Auto" Margin="12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="Show pointer in screen recordings" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Include the system pointer in screen captures." FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/></StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="True" OnContent="" OffContent="" Width="38" VerticalAlignment="Center" Margin="12,0,0,0" />
              </Grid>
              <Border Height="1" Background="#2F2F2F" />
              <Grid MinHeight="68" ColumnDefinitions="*,Auto" Margin="12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="Auto zoom on clicks" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Click tracking is not available in this build." FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/></StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="False" OnContent="" OffContent="" Width="38" VerticalAlignment="Center" Margin="12,0,0,0" IsEnabled="False" ToolTip.Tip="Click tracking is not available in this build." />
              </Grid>
              <Border Height="1" Background="#2F2F2F" />
              <Grid MinHeight="62" ColumnDefinitions="*,Auto" Margin="12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="Default zoom amount" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Zoom segments are not available in this editor." FontSize="12" Foreground="#A0A0A0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Slider Minimum="1" Maximum="4.5" Value="1.5" Width="110" IsEnabled="False"/><TextBlock Text="1.5x" FontSize="12" Foreground="#777777" VerticalAlignment="Center"/></StackPanel>
              </Grid>
              <Border Height="1" Background="#2F2F2F" />
              <Grid MinHeight="62" ColumnDefinitions="*,Auto" Margin="12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="Capture keyboard presses" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Keyboard overlays are not available in this editor." FontSize="12" Foreground="#A0A0A0"/></StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="False" OnContent="" OffContent="" Width="38" VerticalAlignment="Center" Margin="12,0,0,0" IsEnabled="False" ToolTip.Tip="Keyboard overlays are not available in this editor." />
              </Grid>
              <Border Height="1" Background="#2F2F2F" />
              <Grid MinHeight="82" ColumnDefinitions="*,Auto" Margin="12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="Draw the MacBook notch on screen recordings" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Notch restoration is not available in this build." FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/></StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="False" OnContent="" OffContent="" Width="38" VerticalAlignment="Center" Margin="12,0,0,0" IsEnabled="False" ToolTip.Tip="Notch restoration is not available in this build." />
              </Grid>
              <Border Height="1" Background="#2F2F2F" />
              <Grid MinHeight="62" ColumnDefinitions="*,Auto" Margin="12,8">
                <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="Max capture framerate" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Maximum framerate for screen capture." FontSize="12" Foreground="#A0A0A0"/></StackPanel>
                <ComboBox Grid.Column="1" SelectedIndex="1" Width="108" Height="29" VerticalAlignment="Center" Background="#282828" BorderBrush="#383838" Foreground="#EEEEEE" CornerRadius="9"><ComboBoxItem Content="30 FPS"/><ComboBoxItem Content="60 FPS"/><ComboBoxItem Content="90 FPS"/><ComboBoxItem Content="120 FPS"/></ComboBox>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Storage" FontSize="14" FontWeight="SemiBold" Foreground="#F1F1F1" />
          <TextBlock Text="Where Cap saves your recordings." FontSize="12" Foreground="#A1A1A1" />
          <Border Margin="-4,8,-4,0" Padding="12" Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12">
            <StackPanel Spacing="10">
              <Border Padding="9,7" Background="#242424" CornerRadius="8"><TextBlock x:Name="RecordingFolderDisplay" Text="Default (Application Support)" FontSize="12" FontFamily="monospace" Foreground="#E5E5E5" TextTrimming="CharacterEllipsis" /></Border>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="ResetRecordingFolderButton" Content="Reset to Default" Classes="action" Padding="12,0" IsVisible="False" Click="OnResetRecordingsFolder" />
                <Button Content="Choose Folder" Classes="action" Padding="14,0" Click="OnChooseRecordingsFolder" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Default project name" FontSize="14" FontWeight="SemiBold" Foreground="#F1F1F1" />
          <TextBlock Text="Template used for new recordings and exported files." FontSize="12" Foreground="#A1A1A1" />
          <Border Margin="-4,8,-4,0" Padding="12" Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12">
            <StackPanel Spacing="9">
              <TextBox x:Name="ProjectNameInput" Tag="project-name" Text="{}{target_name} ({target_kind}) {date} {time}" TextChanged="OnProjectNameChanged" Background="#242424" BorderBrush="#383838" Foreground="#E5E5E5" FontFamily="monospace" MinHeight="34" />
              <Border Padding="9,7" Background="#242424" BorderBrush="#353535" BorderThickness="1" CornerRadius="8"><TextBlock x:Name="ProjectNamePreview" Text="Screen Recording (Display) 2026-10-06 09-41" FontSize="12" Foreground="#D8D8D8" TextWrapping="Wrap" /></Border>
              <TextBlock Text="Available placeholders include {recording_mode}, {mode}, {target_name}, {target_kind}, {date}, and {time}." FontSize="11" Foreground="#949494" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Excluded windows" FontSize="14" FontWeight="SemiBold" Foreground="#F1F1F1" />
          <TextBlock Text="Hide windows from recordings." FontSize="12" Foreground="#A1A1A1" />
          <Border Margin="-4,8,-4,0" Padding="12" Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Window-level exclusion is not available in this build." FontSize="12" Foreground="#A0A0A0" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Reset" Classes="action" Padding="12,0" IsEnabled="False"/><Button Content="+  Add" Classes="action" Padding="12,0" IsEnabled="False" /></StackPanel></Grid>
          </Border>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Updates" FontSize="14" FontWeight="SemiBold" Foreground="#F1F1F1" />
          <TextBlock Text="Automatic updates are not included in the Avalonia port." FontSize="12" Foreground="#A1A1A1" />
          <Border Margin="-4,8,-4,0" Padding="12" Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="Update channel" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="Cap's automatic updater is not included in this port." FontSize="12" Foreground="#A0A0A0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><Button Content="Stable" Classes="action" Padding="12,0" IsEnabled="False"/><Button Content="Nightly" Classes="action" Padding="12,0" IsEnabled="False"/></StackPanel></Grid>
              <Border Padding="9,7" Background="#242424" CornerRadius="8"><TextBlock Text="Updates are managed manually for this build." FontSize="12" Foreground="#C7C7C7" /></Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Self-host" FontSize="14" FontWeight="SemiBold" Foreground="#F1F1F1" />
          <TextBlock Text="Server configuration is unavailable because online services are not connected." FontSize="12" Foreground="#A1A1A1" TextWrapping="Wrap" />
          <Border Margin="-4,8,-4,0" Padding="12" Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Cap Server URL" FontSize="13" Foreground="#F1F1F1" />
              <TextBox Tag="server-url" Text="https://cap.so" Background="#242424" BorderBrush="#383838" Foreground="#E5E5E5" MinHeight="34" IsEnabled="False" ToolTip.Tip="Self-hosted services are not connected." />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Reset to Default" Classes="action" Padding="12,0" IsEnabled="False"/><Button Content="Update" Classes="action" Padding="12,0" IsEnabled="False"/></StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Privacy" FontSize="14" FontWeight="SemiBold" Foreground="#F1F1F1" />
          <Border Margin="-4,8,-4,0" Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12">
            <Grid MinHeight="74" ColumnDefinitions="*,Auto" Margin="12,8">
              <StackPanel Spacing="3" VerticalAlignment="Center"><TextBlock Text="Share anonymous telemetry" FontSize="13" Foreground="#F1F1F1"/><TextBlock Text="This app does not collect or send telemetry." FontSize="12" Foreground="#A0A0A0" TextWrapping="Wrap"/></StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="False" OnContent="" OffContent="" Width="38" VerticalAlignment="Center" Margin="12,0,0,0" IsEnabled="False" ToolTip.Tip="This app does not send telemetry." />
            </Grid>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="OtherPageContent" Grid.Column="1" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="OtherPageBody" Margin="20,18,20,24" Spacing="28" />
    </ScrollViewer>
  </Grid>
</Window>
